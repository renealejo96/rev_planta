# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# En el VPS copia este archivo a .env: cp .env.example .env y pon tus claves reales
# ==============================================================================

DJANGO_SECRET_KEY=cambia-esta-clave-secreta-en-produccion-genera-una-segura
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_O_DOMINIO_DEL_VPS
# Si usas dominio o IP directamente en Django, configúralo para evitar errores de CSRF:
CSRF_TRUSTED_ORIGINS=http://TU_IP_DEL_VPS:8420,https://tu-dominio.com

# Puerto personalizado para no chocar con otras aplicaciones en el VPS
APP_PORT=8420
# Usa 0.0.0.0 para acceder directamente por http://IP_VPS:8420 o 127.0.0.1 si tienes Nginx proxy en el VPS
APP_BIND_IP=0.0.0.0

DB_NAME=calidad_planta
DB_USER=postgres
DB_PASSWORD=inventa_una_contrasena_segura_aqui
DB_HOST=db
DB_PORT=5432

# Clave de IA (Google Gemini Vision) para leer guías físicas escritas a mano con esfero
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
